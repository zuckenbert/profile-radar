{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "0.4.0",
  "default_locale": "en",
  "icons": { "16": "img/icon16.png", "32": "img/icon32.png", "48": "img/icon48.png", "128": "img/icon128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "img/icon16.png", "32": "img/icon32.png", "48": "img/icon48.png" },
    "default_title": "__MSG_extName__"
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/analytics/profile-views*"],
      "js": ["lib/extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
